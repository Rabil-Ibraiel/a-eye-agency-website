# Inquiry delivery
# The form returns HTTP 503 until this server-only webhook is configured.
INQUIRY_WEBHOOK_URL=

# Optional public fallback shown only when it contains a real contact address.
# NEXT_PUBLIC_ values are embedded into the browser bundle at build time.
NEXT_PUBLIC_CONTACT_EMAIL=

# Canonical public origin used for sitemap, robots, and social metadata.
NEXT_PUBLIC_SITE_URL=

# Public sub-path used by static hosts such as GitHub Pages.
NEXT_PUBLIC_BASE_PATH=
